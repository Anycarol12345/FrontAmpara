server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Mantém o Host original: o backend lê a funerária do subdomínio (TEN-01).
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        # HTTP/1.1: o Kestrel recusa POST sem corpo (refresh, logout) em HTTP/1.0.
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hubs/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    # Configuração em tempo de execução: nunca em cache.
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # Arquivos com hash no nome podem ficar em cache para sempre.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Rotas da SPA: qualquer caminho que não é arquivo abre o index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
