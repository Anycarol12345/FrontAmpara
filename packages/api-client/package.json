    "msw": "^3.0.3",
    "orval": "^8.45.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
