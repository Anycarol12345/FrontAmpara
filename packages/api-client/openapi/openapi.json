{
  "openapi": "3.1.1",
  "info": {
    "title": "Funerária Online API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:5080/"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Entra na funerária do endereço acessado (ou na plataforma, para o ADMIN)",
        "description": "Devolve o access token no corpo e o refresh token em cookie httpOnly.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "Locked",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Troca o refresh token do cookie por um access token novo",
        "operationId": "RenovarSessao",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Encerra a sessão e revoga o refresh token",
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/minhas-funerarias": {
      "get": {
        "tags": ["Autenticação"],
        "summary": "Funerárias em que o usuário tem vínculo ativo",
        "operationId": "MinhasFunerarias",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FunerariaVinculadaResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/planos": {
      "get": {
        "tags": ["Planos"],
        "summary": "Lista os planos ativos da funerária",
        "operationId": "ListarPlanos",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlanoResumoResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/planos/{id}": {
      "get": {
        "tags": ["Planos"],
        "summary": "Detalhe de um plano ativo da funerária",
        "operationId": "ObterPlano",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanoResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/gestao/planos": {
      "get": {
        "tags": ["Planos"],
        "summary": "Lista todos os planos da funerária, ativos e inativos",
        "operationId": "GestaoListarPlanos",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlanoResumoResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Planos"],
        "summary": "Cria um plano",
        "operationId": "CriarPlano",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanoCriadoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/gestao/planos/{id}": {
      "get": {
        "tags": ["Planos"],
        "summary": "Detalhe de um plano da funerária",
        "operationId": "GestaoObterPlano",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanoResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Planos"],
        "summary": "Edita um plano. Novo valor vale só para novos contratos",
        "operationId": "AtualizarPlano",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/gestao/planos/{id}/status": {
      "patch": {
        "tags": ["Planos"],
        "summary": "Ativa ou desativa um plano",
        "operationId": "AlterarStatusPlano",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlterarStatusPlanoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlterarStatusPlanoRequest": {
        "required": ["ativo"],
        "type": "object",
        "properties": {
          "ativo": {
            "type": "boolean"
          }
        },
        "description": "Corpo de PATCH /gestao/planos/{id}/status."
      },
      "ConfiguracaoDependentes": {
        "type": "object",
        "properties": {
          "idade_maxima_filhos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          }
        }
      },
      "ConfiguracaoTranslado": {
        "type": "object",
        "properties": {
          "km_incluso": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "internacional": {
            "type": "boolean"
          }
        }
      },
      "ConfiguracaoVelorio": {
        "type": "object",
        "properties": {
          "horas_incluidas": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "sala_vip": {
            "type": "boolean"
          }
        }
      },
      "FunerariaVinculadaResponse": {
        "required": ["id_tenant", "slug", "nome_fantasia", "perfil", "suspensa"],
        "type": "object",
        "properties": {
          "id_tenant": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "nome_fantasia": {
            "type": "string"
          },
          "perfil": {
            "type": "string"
          },
          "suspensa": {
            "type": "boolean"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": ["null", "string"]
          },
          "title": {
            "type": ["null", "string"]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "detail": {
            "type": ["null", "string"]
          },
          "instance": {
            "type": ["null", "string"]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginRequest": {
        "required": ["email", "senha"],
        "type": "object",
        "properties": {
          "email": {
            "type": ["null", "string"]
          },
          "senha": {
            "type": ["null", "string"]
          }
        },
        "description": "Campos opcionais aqui para a validação devolver as mensagens do card em vez de erro de desserialização."
      },
      "LoginResponse": {
        "required": ["access_token", "expira_em", "usuario"],
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expira_em": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioSessao"
          }
        },
        "description": "Resposta do login e da renovação (AUT-02). O refresh token vai só no cookie."
      },
      "PlanoConfiguracoes": {
        "type": "object",
        "properties": {
          "versao": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "translado": {
            "$ref": "#/components/schemas/ConfiguracaoTranslado"
          },
          "velorio": {
            "$ref": "#/components/schemas/ConfiguracaoVelorio"
          },
          "cremacao_inclusa": {
            "type": "boolean"
          },
          "transmissao_online": {
            "type": "boolean"
          },
          "dependentes": {
            "$ref": "#/components/schemas/ConfiguracaoDependentes"
          }
        },
        "description": "Regras flexíveis do plano, gravadas na coluna jsonb `configuracoes` (PLA-03).\r\nO que é usado em filtros e cálculos frequentes fica em coluna, e não aqui."
      },
      "PlanoCriadoResponse": {
        "required": ["id_plano"],
        "type": "object",
        "properties": {
          "id_plano": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PlanoRequest": {
        "required": [
          "nome",
          "descricao",
          "valor_mensal",
          "valor_anual",
          "valor_dependente_mensal",
          "valor_dependente_anual",
          "carencia_dias",
          "limite_dependentes",
          "permite_somente_dependente",
          "configuracoes"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": ["null", "string"]
          },
          "valor_mensal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_anual": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_dependente_mensal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_dependente_anual": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "carencia_dias": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "limite_dependentes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "permite_somente_dependente": {
            "type": "boolean"
          },
          "configuracoes": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PlanoConfiguracoes"
              }
            ]
          }
        },
        "description": "Corpo de POST /gestao/planos e PUT /gestao/planos/{id}."
      },
      "PlanoResponse": {
        "required": [
          "id_plano",
          "nome",
          "descricao",
          "valor_mensal",
          "valor_anual",
          "valor_dependente_mensal",
          "valor_dependente_anual",
          "carencia_dias",
          "limite_dependentes",
          "permite_somente_dependente",
          "configuracoes",
          "ativo"
        ],
        "type": "object",
        "properties": {
          "id_plano": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": ["null", "string"]
          },
          "valor_mensal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_anual": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_dependente_mensal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_dependente_anual": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "carencia_dias": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "limite_dependentes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "permite_somente_dependente": {
            "type": "boolean"
          },
          "configuracoes": {
            "$ref": "#/components/schemas/PlanoConfiguracoes"
          },
          "ativo": {
            "type": "boolean"
          }
        }
      },
      "PlanoResumoResponse": {
        "required": ["nome"],
        "type": "object",
        "properties": {
          "id_plano": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "type": ["null", "string"]
          },
          "valor_mensal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_anual": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_dependente_mensal": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "valor_dependente_anual": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "carencia_dias": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "limite_dependentes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "ativo": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": ["null", "string"]
          },
          "title": {
            "type": ["null", "string"]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "detail": {
            "type": ["null", "string"]
          },
          "instance": {
            "type": ["null", "string"]
          }
        }
      },
      "UsuarioSessao": {
        "required": ["id", "nome", "role"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Access token JWT obtido em POST /api/v1/auth/login.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
